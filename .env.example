# --- Email (Gmail) ---
# Create an App Password: https://myaccount.google.com/apppasswords (needs 2FA on)
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_TO=you@gmail.com

# --- Telegram (optional, leave empty to skip) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude (scoring + form answers) ---
ANTHROPIC_API_KEY=
# Absolute path to your CV PDF on the Mac (docker-compose mounts it into the scheduler)
CV_PATH=/absolute/path/to/CV.pdf

# MongoDB - leave unset: localhost on the Mac, docker-compose sets it inside the containers
# MONGO_URL=mongodb://localhost:27017
